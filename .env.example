# The embedded UI/API is loopback-only. Port 4317 avoids ports reserved by sibling projects.
MARKET_CHART_HOST=127.0.0.1
MARKET_CHART_PORT=4317

# CSV files exposed to MCP must resolve inside this directory.
MARKET_CHART_DATA_ROOT=./data

# Optional bearer protection for REST data routes.
# MARKET_CHART_API_TOKEN=replace-with-a-long-random-value

# Set false only if chart_snapshot is never used.
MARKET_CHART_SCREENSHOTS=true

# Optional official TradingView Supercharts automation. Disabled by default.
TRADINGVIEW_BROWSER_ENABLED=false
TRADINGVIEW_BROWSER_BASE_URL=https://www.tradingview.com
TRADINGVIEW_BROWSER_HEADLESS=true
TRADINGVIEW_BROWSER_TIMEOUT_MS=30000

# Choose one local authentication source. Keep it outside the repository and chmod 600.
# TRADINGVIEW_BROWSER_AUTH_STATE=/absolute/path/to/playwright-storage-state.json
# TRADINGVIEW_BROWSER_COOKIE_FILE=/absolute/path/to/tradingview-cookie-export.txt
