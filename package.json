{
  "name": "@moeuu/tradingview-mcp",
  "version": "0.4.0",
  "description": "Local-first MCP server and loopback chart API for market data analysis and TradingView workflows.",
  "license": "MIT",
  "author": {
    "name": "moeuu",
    "url": "https://github.com/moeuu"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moeuu/tradingview-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/moeuu/tradingview-mcp/issues"
  },
  "homepage": "https://github.com/moeuu/tradingview-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tradingview",
    "market-data",
    "technical-analysis",
    "stdio",
    "playwright"
  ],
  "type": "module",
  "bin": {
    "tradingview-mcp": "dist/mcp.js",
    "market-chart-mcp": "dist/mcp.js",
    "market-chart-api": "dist/standalone.js",
    "market-chart-history": "dist/history.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "clean": "node scripts/clean.mjs",
    "dev:mcp": "vite build && tsx src/mcp.ts",
    "dev:api": "vite build && tsx src/standalone.ts",
    "history": "tsx src/history.ts",
    "start": "node dist/mcp.js",
    "serve": "node dist/standalone.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "check:public": "node scripts/check-public-safety.mjs",
    "check": "npm run check:public && npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "files": [
    "dist/",
    "dist-web/",
    "docs/",
    "licenses/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/static": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "csv-parse": "^7.0.1",
    "fastify": "^5.10.0",
    "lightweight-charts": "^5.2.0",
    "playwright": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
